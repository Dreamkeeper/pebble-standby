<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext stays permitted at the platform level because this file cannot
  express address ranges, and the recommended tailnet deployment reaches the
  server by its Tailscale address or MagicDNS name over plain HTTP. The
  actual rule lives in ServerUrlPolicy (owner decision 2026-10-14): http://
  is accepted only for the Tailscale range 100.64.0.0/10 and *.ts.net, the
  RFC 1918 home-network ranges, loopback and *.local / *.lan names; every
  other host must be https://. Both URL inputs and ServerClient enforce it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
