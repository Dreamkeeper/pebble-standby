    <!-- Detectors -->
    <string name="det_pulse">Pulse signal loss</string>
    <string name="det_pulse_what">The optical sensor stops giving a changing pulse reading while you are still. The watch first checks for 45 seconds at full rate, then asks "Are you OK?", then counts down, then your people are alerted.</string>
    <string name="det_pulse_limits">A loose strap, a cold wrist or the watch lying on a table also stop the signal. That is why the watch asks first instead of alerting at once. It cannot tell you why the signal stopped.</string>
    <string name="det_pulse_value">asks after %1$s without signal</string>
    <string name="det_impact">Hard impact</string>
    <string name="det_impact_what">A fall or a hard knock, followed by no movement for the time below. Only a press of SELECT on the watch, or Cancel on this phone, dismisses it.</string>
    <string name="det_impact_limits">Dropping the watch on a desk also counts as a knock; because you are not wearing it then, no pulse reading follows and the alert is discarded.</string>
    <string name="det_impact_value">asks after %1$d s of stillness</string>
    <string name="det_nonmotion">No movement</string>
    <string name="det_nonmotion_what">No movement at all for the time below, by day or at night. A steady pulse counts as being alive, so sleeping does not trigger it on watches with a pulse sensor.</string>
    <string name="det_nonmotion_limits">On watches without a pulse sensor this is the main detector, so set the night time generously.</string>
    <string name="det_nonmotion_value">%1$d min by day, %2$d min at night</string>
    <string name="det_checkin">Scheduled check-in</string>
    <string name="det_checkin_what">The watch asks you to press SELECT at a fixed interval. Movement does not answer it; only the button does.</string>
    <string name="det_checkin_limits">Off by default. Useful when you prefer a routine over sensors, or on a watch without a pulse sensor.</string>
    <string name="det_checkin_value">every %1$s</string>
    <string name="det_notworn">Not worn reminders</string>
    <string name="det_notworn_what">When the watch sees no pulse signal and no movement, it reminds you to put it on or pause monitoring. Nobody else is alerted.</string>
    <string name="det_notworn_limits">Also covers the opposite case: movement without any pulse signal, which means a loose strap or a sensor fault.</string>
    <string name="det_notworn_value">after %1$d min off-wrist</string>
