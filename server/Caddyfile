# Reverse proxy for the VPS deployment (docker-compose.vps.yml).
# Caddy obtains and renews Let's Encrypt certificates on its own; the
# domain's DNS A/AAAA record must point at this machine and ports 80 and
# 443 must be reachable from the internet.

{$CM_DOMAIN} {
	encode gzip
	# HSTS belongs to the TLS terminator; the app sets the other headers.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy monitor:8080
}

# Optional self-hosted push server for contacts. Set CM_NTFY_DOMAIN to a
# second DNS name to let contacts subscribe. Unset, the site keeps the
# placeholder name and answers 404: Caddy picks a site by the name the
# client presents, so a placeholder is still reachable by anyone who
# sends it as SNI or Host (security hunt 2026-10-26).
{$CM_NTFY_DOMAIN:ntfy.localhost} {
	@placeholder host ntfy.localhost
	respond @placeholder 404
	reverse_proxy ntfy:80
}
